# ============================================================
# Copiar a .env.local y rellenar con los valores correspondientes
#
# Modos de entorno (npm run dev siempre):
#   Supabase local   →  URL=http://127.0.0.1:54321 (npm run supabase:start)
#   Supabase remoto  →  URL=https://xxx.supabase.co
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Remoto:  obtener en https://app.supabase.com/project/_/settings/api
# Local:   obtener ejecutando: npm run supabase:status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email ─────────────────────────────────────────────────────
# Obtener en: https://resend.com/api-keys
# Para local se puede dejar como dummy
RESEND_API_KEY=re_dummy_local
# Dirección remitente para emails transaccionales
# En producción debe coincidir con un dominio verificado en Resend
EMAIL_FROM=no-reply@proof-day.com

# ── App ───────────────────────────────────────────────────────
# En local: http://localhost:3000
# En Vercel: configurar con el dominio real de producción
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron jobs ─────────────────────────────────────────────────
# Secret para proteger las rutas /api/cron/*
# Generar con: openssl rand -base64 32
# Configurar en Vercel como variable de entorno de producción
CRON_SECRET=

# ── IA Sintetizadora (Epic 12) ─────────────────────────────────
# Ollama corre en local via Docker: docker compose -f docker-compose.dev.yml up -d
# Después de arrancar: ./scripts/ollama-setup.sh  (descarga qwen2.5:3b ~2GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Presupuesto diario máximo estimado (tokens procesados)
AI_DAILY_BUDGET_USD=5.0

# Feature flag — activa toda la IA del producto (wizard, score interpretation, síntesis).
# Cualquier valor distinto de "true" desactiva la IA. Default: OFF.
# NEXT_PUBLIC_* se inlina en build-time en el cliente; cambiar este valor requiere redeploy.
NEXT_PUBLIC_AI_ENABLED=true

# ── Webhooks ──────────────────────────────────────────────────
# Secret para proteger /api/webhooks/*
# Generar con: openssl rand -base64 32
WEBHOOK_SECRET=
